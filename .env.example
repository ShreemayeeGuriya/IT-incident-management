# Copy to .env at the repository root and replace every placeholder.
# Spring loads this file through spring.config.import in application.properties.

# PostgreSQL connection used by the backend.
DB_URL=jdbc:postgresql://localhost:5432/replace_with_database_name
DB_USERNAME=replace_with_database_user
DB_PASSWORD=replace_with_database_password

# Required for every application run. Generate a new random value; do not use this placeholder as a key.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Optional first-admin bootstrap. If APP_ADMIN_PASSWORD is blank, startup skips creating an admin.
APP_ADMIN_NAME=Local Administrator
APP_ADMIN_EMAIL=admin@example.invalid
APP_ADMIN_PASSWORD=REPLACE_WITH_A_LOCAL_ADMIN_PASSWORD

# Optional deterministic simulated-email failure demonstration (comma-separated recipient addresses).
NOTIFICATION_EMAIL_SIMULATE_FAILURE_FOR=
NOTIFICATION_EMAIL_RETRY_INTERVAL_MS=60000
NOTIFICATION_EMAIL_RETRY_INITIAL_DELAY_MS=60000

# Optional SLA monitor settings.
SLA_APPROACHING_THRESHOLD=0.8
SLA_MONITOR_INTERVAL_MS=60000
SLA_MONITOR_INITIAL_DELAY_MS=60000
SLA_MONITOR_BATCH_SIZE=100
