Table users {
  user_id int [pk, increment]
  name varchar(100) [not null]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  role varchar(20) [not null]
}

Table technicians {
  technician_id int [pk, increment]
  user_id int [not null, unique]
  max_workload int
  availability_status varchar(30)
  experience_level varchar(30)
}

Ref: technicians.user_id - users.user_id


Table skills {
  skill_id int [pk, increment]
  skill_name varchar(100) [not null, unique]
}

Table technician_skills {
  technician_id int [not null]
  skill_id int [not null]
  proficiency_level varchar(30)

  indexes {
    (technician_id, skill_id) [pk]
  }
}

Table categories {
  category_id int [pk, increment]
  category_name varchar(100) [not null, unique]
  description text
}

Table services {
  service_id int [pk, increment]
  service_name varchar(150) [not null, unique]
  description text
}

Table sla_policies {
  sla_policy_id int [pk, increment]
  policy_name varchar(100) [not null]
  priority varchar(20) [not null]
  response_time_minutes int [not null]
  resolution_time_minutes int [not null]
}

Table incidents {
  incident_id int [pk, increment]

  reporter_id int [not null]
  assigned_technician_id int
  category_id int [not null]
  service_id int [not null]
  sla_policy_id int

  description text [not null]

  impact varchar(20) [not null]
  urgency varchar(20) [not null]
  business_criticality varchar(20) [not null]
  priority varchar(20) [not null]

  status varchar(30) [not null]
  sla_status varchar(30) [not null]

  investigation_details text
  resolution_details text
  closure_details text

  created_at timestamp [not null]
  resolved_at timestamp
  closed_at timestamp

  response_deadline timestamp
  resolution_deadline timestamp
}

Table audit_logs {
  audit_id int [pk, increment]

  incident_id int [not null]
  actor_user_id int

  action varchar(100) [not null]
  old_value text
  new_value text
  description text

  timestamp timestamp [not null]
}

Table incident_escalations {
  escalation_id int [pk, increment]
  incident_id int [not null]
  escalation_level int [not null]
  trigger_objective varchar(20) [not null]
  created_at timestamp [not null]

  indexes {
    (incident_id, escalation_level) [unique]
    (incident_id, created_at)
  }
}

Table notifications {
  notification_id int [pk, increment]
  user_id int [not null]
  incident_id int
  message text [not null]
  notification_type varchar(50) [not null]
  delivery_status varchar(30) [not null]
  is_read boolean [not null, default: false]
  created_at timestamp [not null]
  read_at timestamp
}

Ref: technician_skills.technician_id > technicians.technician_id
Ref: technician_skills.skill_id > skills.skill_id

Ref: incidents.reporter_id > users.user_id
Ref: incidents.assigned_technician_id > technicians.technician_id
Ref: incidents.category_id > categories.category_id
Ref: incidents.service_id > services.service_id
Ref: incidents.sla_policy_id > sla_policies.sla_policy_id

Ref: audit_logs.incident_id > incidents.incident_id
Ref: audit_logs.actor_user_id > users.user_id

Ref: incident_escalations.incident_id > incidents.incident_id

Ref: notifications.user_id > users.user_id
Ref: notifications.incident_id > incidents.incident_id
